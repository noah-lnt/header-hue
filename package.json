{
  "name": "headerhue",
  "displayName": "HeaderHue",
  "description": "Dynamic VS Code header color based on your project folder name.",
  "version": "0.1.0",
  "publisher": "NOLANSARL",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noahlanfrit/header-hue"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.0.0"
  }
