{
  "name": "headerhue",
  "displayName": "HeaderHue",
  "description": "Dynamic VS Code header color based on your project folder name.",
  "version": "0.3.0",
  "publisher": "NOLANSARL",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noahlanfrit/header-hue"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.0.0"
  },
  "contributes": {
    "configuration": {
      "title": "HeaderHue",
      "properties": {
        "headerHue.intensity": {
          "type": "number",
          "default": 50,
          "minimum": 0,
          "maximum": 100,
          "markdownDescription": "How strong the title bar color is. `0` is barely tinted, `50` is the default pastel, `100` is fully saturated. Title bar text stays readable at every value."
        }
      }
    }
  }
}
